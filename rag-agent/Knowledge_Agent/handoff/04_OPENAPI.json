{
  "openapi": "3.1.0",
  "info": {
    "title": "Municipal Knowledge Agent",
    "version": "1.1"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Report configuration and index-file presence; this is not a live model test.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/knowledge": {
      "post": {
        "summary": "Knowledge",
        "description": "Keep the context and citation sets identical; failures remain HTTP errors.",
        "operationId": "knowledge_knowledge_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowledgeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeRequest": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ROAD_DAMAGE",
              "STREET_LIGHTING",
              "WASTE",
              "WATER_LEAK",
              "NONE"
            ],
            "title": "Category"
          },
          "department": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Description"
          },
          "strategy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "structure",
                  "fixed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          },
          "prompt_version": {
            "type": "string",
            "enum": [
              "v3_structured",
              "v4_grounded",
              "v5_decision",
              "v6_roles",
              "v7_examples"
            ],
            "title": "Prompt Version",
            "default": "v4_grounded"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "description"
        ],
        "title": "KnowledgeRequest",
        "description": "The integration contract accepts fixed labels and known prompt files only."
      },
      "KnowledgeResponse": {
        "properties": {
          "procedure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Procedure"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "answer_found": {
            "type": "boolean",
            "title": "Answer Found"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceItem"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "procedure",
          "deadline",
          "answer_found"
        ],
        "title": "KnowledgeResponse",
        "description": "Public response fields remain compatible with the original endpoint."
      },
      "SourceItem": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "url",
          "score"
        ],
        "title": "SourceItem",
        "description": "A retrieved context source, not a certificate of every generated claim."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
